{
  "name": "otdf-ui",
  "version": "0.1.1",
  "private": true,
  "description": "Opening the Doors Foundation UI kit: shadcn-vue components themed with the OTDF Aboriginal art style.",
  "files": [
    "src",
    "!src/**/__tests__"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/otdf.css",
    "./assets/*": "./src/assets/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vp build",
    "preview": "vp preview",
    "check": "vp check",
    "test": "vp test",
    "type-check": "vue-tsc --build",
    "relativize": "bun scripts/relativize-imports.mjs"
  },
  "dependencies": {
    "@fontsource-variable/mulish": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.57.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.0.0",
    "npm-run-all2": "^9.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "tailwindcss": "^4.1.0",
    "vue": "^3.5.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
